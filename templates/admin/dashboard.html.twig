{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Панель управления
{% endblock %}

{% block main %}
    <div class="dashboard-actions">
        <a class="btn btn-primary" href="{{ path('admin_sheet_document_upload') }}">
            <i class="fa fa-upload"></i>
            Загрузить PDF
        </a>

        <a class="btn btn-secondary" href="{{ path('admin_sheet_document_index') }}">
            <i class="fa fa-file-import"></i>
            Документы
        </a>

        <a class="btn btn-secondary" href="{{ path('admin_google_sheet_append_log_index') }}">
            <i class="fa fa-table"></i>
            Журнал Google Sheets
        </a>

        <a class="btn btn-secondary" href="{{ path('admin_messenger_failed') }}">
            <i class="fa fa-triangle-exclamation"></i>
            Ошибки очереди
        </a>
    </div>

    <div class="dashboard-stat-grid">
        <a class="dashboard-stat-card" href="{{ path('admin_sheet_document_index') }}">
            <span class="dashboard-stat-label">Документов всего</span>
            <span class="dashboard-stat-value">{{ sheetDocumentsTotalCount }}</span>
            <span class="dashboard-stat-action">Открыть список</span>
        </a>

        <a class="dashboard-stat-card" href="{{ path('admin_sheet_document_index') }}">
            <span class="dashboard-stat-label">В обработке</span>
            <span class="dashboard-stat-value">{{ sheetDocumentsQueuedCount }}</span>
            <span class="dashboard-stat-action">Очередь парсинга и записи</span>
        </a>

        <a class="dashboard-stat-card" href="{{ path('admin_sheet_document_index') }}">
            <span class="dashboard-stat-label">Записано в таблицу</span>
            <span class="dashboard-stat-value">{{ sheetDocumentsWrittenCount }}</span>
            <span class="dashboard-stat-action">Успешные документы</span>
        </a>

        <a class="dashboard-stat-card dashboard-stat-card--danger" href="{{ path('admin_sheet_document_index') }}">
            <span class="dashboard-stat-label">Ошибки документов</span>
            <span class="dashboard-stat-value">{{ sheetDocumentsErrorCount }}</span>
            <span class="dashboard-stat-action">Требуют внимания</span>
        </a>
    </div>

    <div class="dashboard-panel-grid">
        <section class="dashboard-panel">
            <div class="dashboard-panel__header">
                <h2>Последние документы</h2>
                <a href="{{ path('admin_sheet_document_index') }}">Все документы</a>
            </div>

            {% if latestSheetDocuments is empty %}
                <p class="dashboard-empty">Документы еще не загружались.</p>
            {% else %}
                <div class="dashboard-table-wrap">
                    <table class="dashboard-table">
                        <thead>
                        <tr>
                            <th>Файл</th>
                            <th>Статус</th>
                            <th>Загрузил</th>
                            <th>Дата</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for document in latestSheetDocuments %}
                            <tr>
                                <td>
                                    <a href="{{ ea_url()
                                        .setController('App\\\\Controller\\\\Admin\\\\SheetDocumentCrudController')
                                        .setAction('detail')
                                        .setEntityId(document.id)
                                    }}">
                                        {{ document.originalFilename }}
                                    </a>
                                </td>
                                <td>
                                        <span class="badge {{ document.status.badgeClass }}">
                                            {{ document.status.label }}
                                        </span>
                                </td>
                                <td>{{ document.uploadedBy ? document.uploadedBy.email : 'неизвестно' }}</td>
                                <td>{{ document.createdAt ? document.createdAt|date('d.m.Y H:i') : '' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

        <section class="dashboard-panel">
            <div class="dashboard-panel__header">
                <h2>Последние записи в Google Sheets</h2>
                <a href="{{ path('admin_google_sheet_append_log_index') }}">Открыть журнал</a>
            </div>

            {% if latestGoogleSheetLogs is empty %}
                <p class="dashboard-empty">Попыток записи еще не было.</p>
            {% else %}
                <div class="dashboard-table-wrap">
                    <table class="dashboard-table">
                        <thead>
                        <tr>
                            <th>Документ</th>
                            <th>Статус</th>
                            <th>Лист</th>
                            <th>Дата</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for log in latestGoogleSheetLogs %}
                            <tr>
                                <td>
                                    {% if log.sheetDocument %}
                                        <a href="{{ ea_url()
                                            .setController('App\\\\Controller\\\\Admin\\\\SheetDocumentCrudController')
                                            .setAction('detail')
                                            .setEntityId(log.sheetDocument.id)
                                        }}">
                                            {{ log.sheetDocument.originalFilename }}
                                        </a>
                                    {% elseif log.telegramDocument %}
                                        {{ log.telegramDocument.originalFilename }}
                                    {% else %}
                                        неизвестно
                                    {% endif %}
                                </td>
                                <td>{{ log.status.label }}</td>
                                <td>{{ log.sheetName }}</td>
                                <td>{{ log.createdAt ? log.createdAt|date('d.m.Y H:i') : '' }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
